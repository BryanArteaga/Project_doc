/* ======== Exercise Details Modal ======== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 1rem;
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.exercise-details-modal {
  background-color: white;
  border-radius: 0.75rem;
  max-width: 600px;
  width: 100%;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  animation: slideUp 0.2s ease-out;
}

.exercise-details-modal.dark {
  background-color: #1e293b;
  color: #f1f5f9;
}

@keyframes slideUp {
  from {
    transform: scale(0.95) translateY(-10px);
    opacity: 0;
  }
  to {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

/* Header */
.exercise-details-modal .modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem;
  border-bottom: 1px solid #e5e7eb;
  gap: 1rem;
}

.exercise-details-modal.dark .modal-header {
  border-bottom-color: #334155;
}

.exercise-details-modal .modal-header h2 {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 700;
  flex: 1;
  word-break: break-word;
  color: #0f172a;
}

.exercise-details-modal.dark .modal-header h2 {
  color: #f1f5f9;
}

.exercise-details-modal .modal-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border: none;
  border-radius: 0.5rem;
  background-color: #f3f4f6;
  color: #1f2937;
  cursor: pointer;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.exercise-details-modal.dark .modal-close {
  background-color: #334155;
  color: #f1f5f9;
}

.exercise-details-modal .modal-close:hover {
  background-color: #e5e7eb;
}

.exercise-details-modal.dark .modal-close:hover {
  background-color: #475569;
}

/* Body */
.exercise-details-modal .modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

/* Image Section */
.image-section {
  width: 100%;
  border-radius: 0.5rem;
  overflow: hidden;
  background-color: #f3f4f6;
}

.exercise-details-modal.dark .image-section {
  background-color: #0f172a;
}

.exercise-image {
  width: 100%;
  height: auto;
  max-height: 300px;
  object-fit: cover;
  display: block;
}

/* Details Section */
.details-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.details-section h3 {
  margin: 0;
  font-size: 1rem;
  font-weight: 600;
  color: #0f172a;
}

.exercise-details-modal.dark .details-section h3 {
  color: #f1f5f9;
}

.details-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1rem;
}

.detail-item {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding: 0.75rem;
  background-color: #f9fafb;
  border-radius: 0.5rem;
  border: 1px solid #e5e7eb;
}

.exercise-details-modal.dark .detail-item {
  background-color: #0f172a;
  border-color: #334155;
}

.detail-label {
  font-size: 0.85rem;
  font-weight: 600;
  color: #6b7280;
}

.exercise-details-modal.dark .detail-label {
  color: #94a3b8;
}

.detail-value {
  margin: 0;
  font-size: 0.95rem;
  color: #1f2937;
  word-break: break-word;
}

.exercise-details-modal.dark .detail-value {
  color: #e2e8f0;
}

/* Action Buttons */
.action-buttons {
  display: flex;
  gap: 1rem;
  padding-top: 1rem;
  border-top: 1px solid #e5e7eb;
}

.exercise-details-modal.dark .action-buttons {
  border-top-color: #334155;
}

.btn-action {
  flex: 1;
  padding: 0.75rem 1rem;
  border: none;
  border-radius: 0.5rem;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-assign {
  background-color: #3b82f6;
  color: white;
}

.btn-assign:hover {
  background-color: #2563eb;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
}

.btn-assigned {
  background-color: #10b981;
  color: white;
}

.btn-assigned:hover {
  background-color: #059669;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
}

.exercise-details-modal.dark .btn-assign {
  background-color: #60a5fa;
}

.exercise-details-modal.dark .btn-assign:hover {
  background-color: #3b82f6;
}

.exercise-details-modal.dark .btn-assigned {
  background-color: #34d399;
}

.exercise-details-modal.dark .btn-assigned:hover {
  background-color: #10b981;
}

/* Search Section */
.search-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.search-section h3 {
  margin: 0;
  font-size: 1rem;
  font-weight: 600;
  color: #0f172a;
}

.exercise-details-modal.dark .search-section h3 {
  color: #f1f5f9;
}

.search-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.search-icon {
  position: absolute;
  left: 0.75rem;
  color: #9ca3af;
  pointer-events: none;
  flex-shrink: 0;
}

.exercise-details-modal.dark .search-icon {
  color: #64748b;
}

.search-input {
  width: 100%;
  padding: 0.75rem 0.75rem 0.75rem 2.5rem;
  border: 1px solid #d1d5db;
  border-radius: 0.5rem;
  font-size: 0.95rem;
  background-color: white;
  color: #0f172a;
  transition: border-color 0.2s ease;
}

.exercise-details-modal.dark .search-input {
  background-color: #0f172a;
  border-color: #475569;
  color: #f1f5f9;
}

.search-input:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.exercise-details-modal.dark .search-input:focus {
  border-color: #60a5fa;
  box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.1);
}

.filters-wrapper {
  display: flex;
  gap: 0.5rem;
}

.filter-select {
  flex: 1;
  padding: 0.5rem 0.75rem;
  border: 1px solid #d1d5db;
  border-radius: 0.5rem;
  font-size: 0.9rem;
  background-color: white;
  color: #0f172a;
  cursor: pointer;
  transition: border-color 0.2s ease;
}

.exercise-details-modal.dark .filter-select {
  background-color: #0f172a;
  border-color: #475569;
  color: #f1f5f9;
}

.filter-select:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.exercise-details-modal.dark .filter-select:focus {
  border-color: #60a5fa;
  box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.1);
}

/* Pacientes Selection */
.pacientes-selection {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  max-height: 300px;
  overflow-y: auto;
  border: 1px solid #e5e7eb;
  border-radius: 0.5rem;
  padding: 0.75rem;
}

.exercise-details-modal.dark .pacientes-selection {
  border-color: #334155;
}

.pacientes-items {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.paciente-checkbox-item {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.5rem;
  border-radius: 0.375rem;
  background-color: #f9fafb;
  border: 1px solid #e5e7eb;
  cursor: pointer;
  transition: all 0.2s ease;
}

.exercise-details-modal.dark .paciente-checkbox-item {
  background-color: #0f172a;
  border-color: #334155;
}

.paciente-checkbox-item:hover {
  background-color: #f3f4f6;
  border-color: #d1d5db;
}

.exercise-details-modal.dark .paciente-checkbox-item:hover {
  background-color: #1e293b;
  border-color: #475569;
}

.checkbox-input {
  margin-top: 0.25rem;
  margin-right: 0.25rem;
  width: 1.25rem;
  height: 1.25rem;
  cursor: pointer;
  accent-color: #3b82f6;
  flex-shrink: 0;
}

.exercise-details-modal.dark .checkbox-input {
  accent-color: #60a5fa;
}

.paciente-info {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  flex: 1;
}

.paciente-nombre {
  font-size: 0.95rem;
  font-weight: 500;
  color: #0f172a;
}

.exercise-details-modal.dark .paciente-nombre {
  color: #f1f5f9;
}

.paciente-enfermedad {
  font-size: 0.85rem;
  color: #6b7280;
}

.exercise-details-modal.dark .paciente-enfermedad {
  color: #94a3b8;
}

.paciente-cedula {
  font-size: 0.8rem;
  color: #9ca3af;
  font-family: monospace;
}

.exercise-details-modal.dark .paciente-cedula {
  color: #64748b;
}

.no-results {
  padding: 1rem;
  text-align: center;
  color: #6b7280;
  font-size: 0.95rem;
}

.exercise-details-modal.dark .no-results {
  color: #94a3b8;
}

/* Assignment Buttons */
.assignment-buttons {
  display: flex;
  gap: 0.75rem;
  padding-top: 1rem;
  border-top: 1px solid #e5e7eb;
}

.exercise-details-modal.dark .assignment-buttons {
  border-top-color: #334155;
}

.btn-cancel {
  flex: 1;
  padding: 0.75rem 1rem;
  border: 1px solid #d1d5db;
  border-radius: 0.5rem;
  background-color: white;
  color: #1f2937;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.exercise-details-modal.dark .btn-cancel {
  background-color: #0f172a;
  border-color: #475569;
  color: #f1f5f9;
}

.btn-cancel:hover {
  background-color: #f3f4f6;
  border-color: #9ca3af;
}

.exercise-details-modal.dark .btn-cancel:hover {
  background-color: #1e293b;
  border-color: #64748b;
}

.btn-assign-submit {
  flex: 1;
  padding: 0.75rem 1rem;
  border: none;
  border-radius: 0.5rem;
  background-color: #10b981;
  color: white;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-assign-submit:hover:not(:disabled) {
  background-color: #059669;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
}

.exercise-details-modal.dark .btn-assign-submit {
  background-color: #34d399;
}

.exercise-details-modal.dark .btn-assign-submit:hover:not(:disabled) {
  background-color: #10b981;
}

.btn-assign-submit:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Assigned Section */
.assigned-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.assigned-section h3 {
  margin: 0;
  font-size: 1rem;
  font-weight: 600;
  color: #0f172a;
}

.exercise-details-modal.dark .assigned-section h3 {
  color: #f1f5f9;
}

.assigned-items {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  max-height: 400px;
  overflow-y: auto;
}

.assigned-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem;
  background-color: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
}

.exercise-details-modal.dark .assigned-item {
  background-color: #0f172a;
  border-color: #334155;
}

.assigned-item:hover {
  background-color: #f3f4f6;
}

.exercise-details-modal.dark .assigned-item:hover {
  background-color: #1e293b;
}

.assigned-info {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  flex: 1;
}

.assigned-nombre {
  font-size: 0.95rem;
  font-weight: 500;
  color: #0f172a;
}

.exercise-details-modal.dark .assigned-nombre {
  color: #f1f5f9;
}

.assigned-enfermedad {
  font-size: 0.85rem;
  color: #6b7280;
}

.exercise-details-modal.dark .assigned-enfermedad {
  color: #94a3b8;
}

.btn-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border: 1px solid #ef4444;
  border-radius: 0.375rem;
  background-color: white;
  color: #ef4444;
  cursor: pointer;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.exercise-details-modal.dark .btn-remove {
  background-color: transparent;
  border-color: #f87171;
  color: #f87171;
}

.btn-remove:hover {
  background-color: #fee2e2;
  border-color: #dc2626;
  color: #dc2626;
}

.exercise-details-modal.dark .btn-remove:hover {
  background-color: rgba(239, 68, 68, 0.1);
  border-color: #f87171;
  color: #f87171;
}

.no-assigned {
  padding: 1.5rem;
  text-align: center;
  color: #6b7280;
  font-size: 0.95rem;
  background-color: #f9fafb;
  border-radius: 0.5rem;
  border: 1px dashed #e5e7eb;
}

.exercise-details-modal.dark .no-assigned {
  background-color: #0f172a;
  border-color: #334155;
  color: #94a3b8;
}

/* Back Button */
.back-button-wrapper {
  display: flex;
  padding-top: 1rem;
  border-top: 1px solid #e5e7eb;
}

.exercise-details-modal.dark .back-button-wrapper {
  border-top-color: #334155;
}

.btn-back {
  flex: 1;
  padding: 0.75rem 1rem;
  border: 1px solid #d1d5db;
  border-radius: 0.5rem;
  background-color: white;
  color: #1f2937;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.exercise-details-modal.dark .btn-back {
  background-color: #0f172a;
  border-color: #475569;
  color: #f1f5f9;
}

.btn-back:hover {
  background-color: #f3f4f6;
  border-color: #9ca3af;
}

.exercise-details-modal.dark .btn-back:hover {
  background-color: #1e293b;
  border-color: #64748b;
}

/* Scrollbar styling */
.pacientes-selection::-webkit-scrollbar,
.assigned-items::-webkit-scrollbar {
  width: 6px;
}

.pacientes-selection::-webkit-scrollbar-track,
.assigned-items::-webkit-scrollbar-track {
  background: #f9fafb;
  border-radius: 0.5rem;
}

.exercise-details-modal.dark .pacientes-selection::-webkit-scrollbar-track,
.exercise-details-modal.dark .assigned-items::-webkit-scrollbar-track {
  background: #0f172a;
}

.pacientes-selection::-webkit-scrollbar-thumb,
.assigned-items::-webkit-scrollbar-thumb {
  background: #d1d5db;
  border-radius: 0.5rem;
}

.exercise-details-modal.dark .pacientes-selection::-webkit-scrollbar-thumb,
.exercise-details-modal.dark .assigned-items::-webkit-scrollbar-thumb {
  background: #475569;
}

.pacientes-selection::-webkit-scrollbar-thumb:hover,
.assigned-items::-webkit-scrollbar-thumb:hover {
  background: #9ca3af;
}

.exercise-details-modal.dark .pacientes-selection::-webkit-scrollbar-thumb:hover,
.exercise-details-modal.dark .assigned-items::-webkit-scrollbar-thumb:hover {
  background: #64748b;
}
