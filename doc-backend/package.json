{
  "name": "doc-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "prisma generate && tsc && cp -r generated dist/",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "maintenance": "ts-node src/scripts/maintenance.ts",
    "db:stats": "ts-node -e \"import('./src/scripts/maintenance').then(m => m.getDatabaseStats())\"",
    "db:clean": "ts-node -e \"import('./src/scripts/maintenance').then(m => m.runMaintenance())\"",
    "init:storage": "ts-node src/scripts/init-storage.ts"
  },
  "dependencies": {
    "@crazyorr/timber": "^0.2.2",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.3.0",
    "@supabase/supabase-js": "^2.95.3",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.2.2",
    "firebase-admin": "^13.6.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-schedule": "^2.1.1",
    "pg": "^8.16.3",
    "prisma-client": "^0.0.0",
    "timber-js": "^0.0.1-security",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.3",
    "@types/node-schedule": "^2.1.8",
    "nodemon": "^3.1.9",
    "prisma": "^7.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "pg": {
      "@types/pg": "$@prisma/adapter-pg/@types/pg"
    }
  },
  "description": "API REST de gestión de salud de pacientes (Node.js + Express + Prisma). La documentación completa está en README.md.",
  "keywords": [
    "health",
    "api",
    "express",
    "prisma",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
