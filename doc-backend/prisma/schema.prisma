generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Doctor {
  id             Int       @id @default(autoincrement())
  supabaseUserId String    @unique
  email          String    @unique
  nombre         String
  apellido       String
  cedula         String    @unique
  telefono       String?
  especialidad   String?
  rol            StaffRole @default(DOCTOR)
  activo         Boolean   @default(true)
  creadoEn       DateTime  @default(now())
  actualizadoEn  DateTime  @updatedAt
  pacientes      Usuario[] @relation("DoctorPacientes")

  @@index([cedula], map: "idx_doctor_cedula")
  @@index([email], map: "idx_doctor_email")
  @@map("doctores")
}

model Usuario {
  id                    Int                   @id @default(autoincrement())
  nombre                String
  apellido              String
  cedula                String?               @unique  // Cédula única - previene duplicados
  fechaNacimiento       DateTime?
  edad                  Int?
  peso                  Float?
  altura                Float?
  sexo                  String?
  enfermedad            String?
  colorEnfermedad       String?
  estadoCuenta          AccountStatus         @default(ACTIVE)
  idDoctorAsignado      Int?
  glucosaInicial        Float?
  colesterolInicial     Float?
  notifEnabled          Boolean               @default(true)
  notifType             String                @default("daily_fixed")
  notifDetails          String                @default("{\"hour\":20}")
  activadoEn            DateTime?
  activadoPor           Int?
  registradoEn          DateTime              @default(now())
  ultimaSincronizacion  DateTime?
  tokenDispositivo      String?
  creadoEn              DateTime              @default(now())
  actualizadoEn         DateTime              @updatedAt
  ejerciciosRealizados  EjercicioRealizado[]
  notificaciones        Notificacion[]
  dispositivos          Dispositivo[]         @relation("UsuarioDispositivos")
  registrosSalud        RegistroSalud[]
  doctorAsignado        Doctor?               @relation("DoctorPacientes", fields: [idDoctorAsignado], references: [id])

  @@index([estadoCuenta])
  @@index([idDoctorAsignado])
  @@map("usuarios")
}

model RegistroSalud {
  id                Int       @id @default(autoincrement())
  usuarioId         Int
  presionSistolica  Int?
  presionDiastolica Int?
  glucosa           Float?
  colesterol        Float?
  temperatura       Float?
  peso              Float?
  calorias          Int?
  ejercicio         String?
  estadoAnimo       String?
  notas             String?
  idSincronizacion  String?
  sincronizadoEn    DateTime?
  fecha             String?
  hora              String?
  registradoEn      DateTime  @default(now())
  creadoEn          DateTime  @default(now())
  actualizadoEn     DateTime  @updatedAt
  usuario           Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, registradoEn])
  @@index([idSincronizacion])
  @@map("registros_salud")
}

model Ejercicio {
  id                  Int                   @id @default(autoincrement())
  nombre              String
  descripcion         String?
  enfermedad          String?
  duracion            Int?
  intensidad          String?
  imagenResId         Int?
  series              Int                   @default(3)
  descansoEntreSeries Int                   @default(30)
  urlImagen           String?
  urlVideo            String?
  creadoEn            DateTime              @default(now())
  actualizadoEn       DateTime              @updatedAt
  realizados          EjercicioRealizado[]

  @@index([enfermedad])
  @@map("ejercicios")
}

model EjercicioRealizado {
  id               Int       @id @default(autoincrement())
  usuarioId        Int
  ejercicioId      Int
  asignacionId     Int?
  idSincronizacion String?
  sincronizadoEn   DateTime?
  fecha            String?
  completadoEn     DateTime  @default(now())
  creadoEn         DateTime  @default(now())
  ejercicio        Ejercicio @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)
  usuario          Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, completadoEn])
  @@index([idSincronizacion])
  @@map("ejercicios_realizados")
}

model Consejo {
  id            Int      @id @default(autoincrement())
  enfermedad    String
  consejo       String
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("consejos")
}

model Notificacion {
  id            Int              @id @default(autoincrement())
  usuarioId     Int
  tipo          NotificationType
  titulo        String
  mensaje       String
  metadatos     Json?
  leido         Boolean          @default(false)
  leidoEn       DateTime?
  enviada       DateTime?        // Para rastrear cuándo fue enviado el push
  creadoEn      DateTime         @default(now())
  actualizadoEn DateTime         @updatedAt
  usuario       Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, leido])
  @@index([tipo])
  @@index([enviada])  // Índice para búsquedas rápidas de notificaciones enviadas
  @@map("notificaciones")
}

model Dispositivo {
  id             Int      @id @default(autoincrement())
  usuarioId      Int
  fcmToken       String   @unique
  deviceId       String?
  activo         Boolean  @default(true)
  ultimaVezVisto DateTime @default(now())
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt
  usuario        Usuario  @relation("UsuarioDispositivos", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([fcmToken])
  @@map("dispositivos")
}

model ConfiguracionSistema {
  id            Int      @id @default(autoincrement())
  clave         String   @unique
  valor         String
  descripcion   String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([clave])
  @@map("configuracion_sistema")
}

enum StaffRole {
  ADMIN
  DOCTOR
}

enum AccountStatus {
  INACTIVE
  ACTIVE
  SUSPENDED
}

enum NotificationType {
  cuenta_activada
  exercise_assigned
  exercise_reminder
  health_check
  message_from_doctor
  account_activated
  health_reminder
}
